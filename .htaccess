# washaij.com — موقعٌ ساكن على استضافة Apache مشتركة

# ١ · الترميز: العربية لا تُقرأ بغيره
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .geojson .svg

# ٢ · أنواع الملفات التي قد لا تعرفها الاستضافة
AddType application/json            .json
AddType application/geo+json        .geojson
AddType image/svg+xml               .svg
AddType application/manifest+json   .webmanifest

# ٣ · توحيد النطاق على washaij.com بلا www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.washaij\.com$ [NC]
  RewriteRule ^ https://washaij.com%{REQUEST_URI} [L,R=301]

  # روابط نظيفة: washaij.com/ و washaij.com/map — والروابط القديمة بـ‎.html تُحوَّل إليها (٣٠١)،
  # ويبقى الاستعلام (?chat=… و?view=…) كما هو. وTHE_REQUEST يمنع الدوران مع التحويل الداخلي تحته.
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[?\s] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # إجبار HTTPS — مُعطَّل، والاستضافة تفعله أصلًا على مستوى الخادم
  # (فُحِص في ٢٤ سبتمبر ٢٠٢٦: http يحوّل إلى https من تلقائه).
  # لا تُفعّله إلا إن توقّف ذلك بعد الرفع، فتحذف # من السطرين:
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://washaij.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ٤ · الضغط — inline-data.js وحده ٢٫٤ م.ب، ويهبط إلى نحو الخُمس
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/geo+json image/svg+xml
</IfModule>

# ٥ · التخزين المؤقّت: الأصول طويلًا، والصفحات قصيرًا لتصل التعديلات
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType application/json          "access plus 1 day"
  ExpiresByType application/geo+json      "access plus 1 day"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# ٦ · لا فهرسة لمجلّد بلا صفحة، والرابط الخاطئ يصل إلى صفحةٍ تدلّه على الطريق
Options -Indexes
ErrorDocument 404 /404.html

# ٧ · منع تنزيل ملفات الإعداد
<FilesMatch "^\.(git|htaccess|gitignore|nojekyll)">
  Require all denied
</FilesMatch>

# ٨ · ترويسات الأمان — الموقع لا يطلب كاميرا ولا ميكروفون ولا موقعًا جغرافيًّا
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
